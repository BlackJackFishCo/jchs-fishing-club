rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /roster/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /submissions/{id} {
      allow read: if true;

      allow create: if
        request.resource.data.speciesId is int &&
        request.resource.data.anglerId is string &&
        request.resource.data.angler is string &&
        request.resource.data.photo is string &&
        request.resource.data.photoPath is string &&
        exists(/databases/$(database)/documents/roster/$(request.resource.data.anglerId)) &&
        get(/databases/$(database)/documents/roster/$(request.resource.data.anglerId)).data.active == true;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /tournamentRegistrations/{id} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.anglers is list &&
        request.resource.data.anglers.size() >= 1 &&
        request.resource.data.anglers.size() <= 4;

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
